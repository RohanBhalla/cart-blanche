# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Agent model provider (Google AI Studio: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Judge model provider, a different family from the agent (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Optional overrides for the model names used when a run config doesn't set them
# CARTBLANCHE_AGENT_MODEL=gemini/gemini-2.5-flash-lite
# CARTBLANCHE_JUDGE_MODEL=openai/gpt-5.4-nano
